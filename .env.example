# Browser-safe values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server runtime values (the publishable key is safe to expose; keep the
# secret key and AI key server-side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY is preferred; SUPABASE_SERVICE_ROLE_KEY is supported for older deployments.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted for older deployments.
GEMINI_API_KEY=
LINK_CHECK_TOKEN=
# Postgres connection string, only for drizzle-kit
DATABASE_URL=
