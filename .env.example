# Browser-safe values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional personal cloud providers. These are public OAuth client IDs/app
# keys, not provider passwords or client secrets.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=
VITE_DROPBOX_APP_KEY=

# Worker runtime values. Set secrets with `wrangler secret put`.
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted for older deployments.
GEMINI_API_KEY=
# Set to "true" to require a signed-in Supabase session for /api/tutor.
TUTOR_REQUIRE_AUTH=
# Optional: enables /api/models for requests sending this value in x-admin-token.
ADMIN_TOKEN=
