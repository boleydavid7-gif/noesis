{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noesis-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "vars": {
    "GEMINI_TUTOR_MODEL": "gemini-2.5-flash",
    "TUTOR_REQUIRE_AUTH": "true",
    "VITE_DROPBOX_APP_KEY": "sx9m3fqvqa9s9oe",
    // Public, as in the built app; the Worker needs it too, to finish connecting Google Drive with the secret.
    "VITE_GOOGLE_DRIVE_CLIENT_ID": "486939287305-4uflkd132at87n3talvbgnec25sbn1r8.apps.googleusercontent.com",
    "VITE_ONEDRIVE_CLIENT_ID": "cff5be64-2952-42d0-a434-d569f62c7dd1",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FPe82WH-6DgriZj9e0FwJA_2ehBLYuV",
    "VITE_SUPABASE_URL": "https://dbcvziimlumlqpehgapi.supabase.co"
  },
  // Review reminders with Noesis closed: every 15 minutes the Worker sends the ones whose time has come.
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
